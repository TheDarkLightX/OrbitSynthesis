{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orbitsynthesis.dev/schema/executable-proof-bundle-v1.json",
  "title": "OrbitSynthesis executable proof bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proof_bundle",
    "controller_artifact",
    "manifest_sha256"
  ],
  "properties": {
    "schema": {
      "const": "orbit-synthesis/executable-proof-bundle/v1"
    },
    "proof_bundle": {
      "$ref": "proof_bundle_v1.schema.json"
    },
    "controller_artifact": {
      "$ref": "controller_dag_artifact_v1.schema.json"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
